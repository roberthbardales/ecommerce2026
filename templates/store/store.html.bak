{% extends 'base.html' %}
{% load static %}

{% block content %}

<section class="section-pagetop bg py-2">
  <div class="container">
    {% if 'search' in request.path %}
      <h2 class="title-page">Resultados de búsqueda</h2>
    {% else %}
      <h2 class="title-page">Nuestros Productos</h2>
    {% endif %}
  </div>
</section>

<section class="section-content padding-y">
<div class="container">

<div class="row">

<!-- ================= SIDEBAR ================= -->
<aside class="col-md-3">

<div class="card">

<!-- CATEGORIES -->
<article class="filter-group">
  <header class="card-header">
    <h6 class="title">Categorías</h6>
  </header>

  <div class="card-body">
    <ul class="list-menu">

      <li>
        <a href="{% url 'app_store:store' %}?min_price={{ request.GET.min_price }}&max_price={{ request.GET.max_price }}">
          Todos los productos
        </a>
      </li>

      {% for category in links %}
      <li>
        <a href="{{ category.get_url }}?min_price={{ request.GET.min_price }}&max_price={{ request.GET.max_price }}">
          {{ category.category_name }}
        </a>
      </li>
      {% endfor %}

    </ul>
  </div>
</article>

<!-- PRICE FILTER -->
<article class="filter-group">
  <header class="card-header">
    <h6 class="title">Rango de precios</h6>
  </header>

  <div class="card-body">

    <form method="GET">

      <div class="form-row">

        <div class="form-group col-md-6">
          <label>Mín</label>
          <select name="min_price" class="form-control">

            <option value="">Mín</option>
            <option value="0" {% if request.GET.min_price == "0" %}selected{% endif %}>S/0</option>
            <option value="50" {% if request.GET.min_price == "50" %}selected{% endif %}>S/50</option>
            <option value="100" {% if request.GET.min_price == "100" %}selected{% endif %}>S/100</option>
            <option value="150" {% if request.GET.min_price == "150" %}selected{% endif %}>S/150</option>
            <option value="200" {% if request.GET.min_price == "200" %}selected{% endif %}>S/200</option>

          </select>
        </div>

        <div class="form-group col-md-6">
          <label>Máx</label>
          <select name="max_price" class="form-control">

            <option value="">Máx</option>
            <option value="100" {% if request.GET.max_price == "100" %}selected{% endif %}>S/100</option>
            <option value="200" {% if request.GET.max_price == "200" %}selected{% endif %}>S/200</option>
            <option value="500" {% if request.GET.max_price == "500" %}selected{% endif %}>S/500</option>
            <option value="1000" {% if request.GET.max_price == "1000" %}selected{% endif %}>S/1000</option>
            <option value="2000" {% if request.GET.max_price == "2000" %}selected{% endif %}>S/2000+</option>

          </select>
        </div>

      </div>

      <button type="submit" class="btn btn-primary btn-block">
        Aplicar
      </button>

    </form>

  </div>
</article>

</div>
</aside>

<!-- ================= MAIN ================= -->
<main class="col-md-9">

<header class="border-bottom mb-4 pb-3">
  <span><b>{{ product_count }}</b> artículos encontrados</span>
</header>

<div class="row">

{% if products %}

  {% for product in products %}
  <div class="col-md-4">
    <figure class="card card-product-grid">

      <div class="img-wrap">
        <a href="{{ product.get_url }}">
          <img src="{{ product.images.url }}">
        </a>
      </div>

      <figcaption class="info-wrap">

        <div class="fix-height">
          <a href="{{ product.get_url }}" class="title">
            {{ product.product_name }}
          </a>

          <div class="price-wrap mt-2">
            <span class="price">S/ {{ product.price }}</span>
          </div>
        </div>

        <a href="{{ product.get_url }}" class="btn btn-block btn-success">
          Ver detalles
        </a>

      </figcaption>

    </figure>
  </div>
  {% endfor %}

{% else %}
  <div class="col-12">
    <h4>No se encontraron resultados</h4>
  </div>
{% endif %}

</div>

<!-- PAGINATION -->
<nav class="mt-4">
{% if products.has_other_pages %}
  <ul class="pagination">

    {% if products.has_previous %}
    <li class="page-item">
      <a class="page-link" href="?page={{ products.previous_page_number }}&min_price={{ request.GET.min_price }}&max_price={{ request.GET.max_price }}">
        Anterior
      </a>
    </li>
    {% endif %}

    {% for i in products.paginator.page_range %}
      {% if products.number == i %}
        <li class="page-item active">
          <a class="page-link">{{ i }}</a>
        </li>
      {% else %}
        <li class="page-item">
          <a class="page-link" href="?page={{ i }}&min_price={{ request.GET.min_price }}&max_price={{ request.GET.max_price }}">
            {{ i }}
          </a>
        </li>
      {% endif %}
    {% endfor %}

    {% if products.has_next %}
    <li class="page-item">
      <a class="page-link" href="?page={{ products.next_page_number }}&min_price={{ request.GET.min_price }}&max_price={{ request.GET.max_price }}">
        Siguiente
      </a>
    </li>
    {% endif %}

  </ul>
{% endif %}
</nav>

</main>

</div>
</div>
</section>

{% endblock %}